# Environment variables for the Daggerheart Campaign Manager.
# Copy this file to .env.local and fill in real values. Never commit secrets.

# Convex deployment used by `npx convex dev` (written automatically by the CLI).
CONVEX_DEPLOYMENT=

# Public Convex URL for the browser client.
NEXT_PUBLIC_CONVEX_URL=

# Phone app links (docs/deploy.md section 5a; src/lib/app-links.ts). Not secret. Set in Vercel Production; leave
# empty locally. Unset or malformed, /.well-known/apple-app-site-association and /.well-known/assetlinks.json are
# served empty and the phone's Google sign-in falls back to the sign-in screen.
# Apple Developer Team ID (10 characters, Membership details).
APPLE_TEAM_ID=
# Comma-separated iOS bundle ids (apps/mobile/app.config.ts), e.g. com.dualityheart.mobile,com.dualityheart.mobile.preview
APPLE_BUNDLE_IDS=
# Comma-separated Android package names (the same ids).
ANDROID_PACKAGE_NAMES=
# Comma-separated SHA-256 signing certificate fingerprints (AA:BB:..., 32 pairs): EAS keystores and Play's app signing key.
ANDROID_SHA256_CERT_FINGERPRINTS=
