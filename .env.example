# Environment variables for the Witherwild Campaign Manager.
# Copy this file to .env.local and fill in real values. Never commit secrets.

# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Never expose this to the browser.
# Not used by authentication (Task 002); reserved for later server-only tasks.
SUPABASE_SERVICE_ROLE_KEY=

# End-to-end test credentials for the single Game Master account.
# Used only by Playwright against a local Supabase instance. Never commit values.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Set to "1" to run the live sign-in/sign-out Playwright tests. Requires a
# running local Supabase instance and a manually created test user.
RUN_SUPABASE_E2E=
